{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webpiano",
  "account_id": "7046457855b37423c07b1b0c6014fe33",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "webpiano.xyz", "custom_domain": true }],
  "vars": {
    "PEDAL_ALLOW_STUN_ONLY": "true",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "webpiano",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PEDAL_SESSIONS",
        "class_name": "PedalSession",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PedalSession"],
    },
  ],
  "ratelimits": [
    {
      "name": "PEDAL_SESSION_RATE_LIMITER",
      "namespace_id": "26082601",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
}
