{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "src/app/globals.css"
  },
  "ignorePatterns": [
    ".next/**",
    ".open-next/**",
    ".wrangler/**",
    "bun.lock",
    "coverage/**",
    "node_modules/**",
    "playwright-report/**",
    "public/sw*",
    "test-results/**"
  ]
}
