{
  "name": "webpiano",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run -f .env.development -- next dev --turbopack",
    "build": "dotenvx run -f .env.production -- next build --webpack",
    "start": "dotenvx run -f .env.production -- next start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check --deny-warnings .",
    "test": "bun test",
    "test:unit": "bun test src test",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "preview": "bun run cf:build && opennextjs-cloudflare preview",
    "deploy": "bun run cf:build && bun run cf:deploy",
    "check": "bun run format:check && bun run lint && bun run test:unit && bun run typecheck && bun run knip && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dotenvx/dotenvx": "2.21.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@serwist/next": "9.5.12",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "9.5.12",
    "shadcn": "4.19.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.11",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-security": "4.0.1",
    "image-size": "2.0.2",
    "jsonc-parser": "3.3.1",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.125.0"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
